---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryOptions = new Map<number, string>();
const publisherOptions = new Map<number, string>();

for (const game of games) {
  if (game.category) categoryOptions.set(game.category.id, game.category.name);
  if (game.publisher) publisherOptions.set(game.publisher.id, game.publisher.name);
}

const categories = [...categoryOptions]
  .map(([id, name]) => ({ id, name }))
  .sort((a, b) => a.name.localeCompare(b.name, 'pl'));
const publishers = [...publisherOptions]
  .map(([id, name]) => ({ id, name }))
  .sort((a, b) => a.name.localeCompare(b.name, 'pl'));
---

<Layout title="Tailspin Toys - Wesprzyj swoją nową ulubioną grę!">
  <div class="py-8">
    <PageHero
      title="Witaj w Tailspin Toys"
      subtitle="Znajdź swoją następną grę. A może nawet ją wesprzesz? Przejrzyj naszą kolekcję!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Polecane gry</h2>

      {games.length === 0 ? (
        <EmptyState text="Na razie nie ma żadnych gier." />
      ) : (
        <>
          <section
            aria-labelledby="game-filters-heading"
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
            data-testid="game-filters"
          >
            <h3 id="game-filters-heading" class="mb-4 text-lg font-medium text-slate-100">
              Filtruj gry
            </h3>

            <div class="grid gap-6 md:grid-cols-2">
              <fieldset>
                <legend class="mb-3 text-sm font-medium text-slate-200">Kategorie</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label
                      for={`category-${category.id}`}
                      class="flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-slate-200"
                    >
                      <input
                        id={`category-${category.id}`}
                        type="checkbox"
                        value={category.id}
                        data-filter-category
                        data-testid={`filter-category-${category.id}`}
                        class="rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex flex-col items-start gap-3">
                <label for="publisher-filter" class="text-sm font-medium text-slate-200">
                  Wydawca
                </label>
                <select
                  id="publisher-filter"
                  data-filter-publisher
                  data-testid="filter-publisher"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">Wszyscy wydawcy</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
                <button
                  type="button"
                  data-clear-filters
                  data-testid="clear-game-filters"
                  class="rounded-lg border border-slate-600 px-3 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  Wyczyść filtry
                </button>
              </div>
            </div>
          </section>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p
            class="hidden mt-6 text-center text-slate-300"
            data-filter-empty
            data-testid="filtered-empty-state"
            role="status"
            aria-live="polite"
          >
            Nie znaleziono gier spełniających wybrane filtry.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilters = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-filter-category]'),
  );
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-filter-publisher]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-game-card]'));
  const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
  const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-clear-filters]');

  /** Aktualizuje widoczność kart na podstawie wszystkich aktywnych filtrów. */
  function applyFilters(): void {
    const selectedCategoryIds = categoryFilters
      .filter((filter) => filter.checked)
      .map((filter) => filter.value);
    const selectedPublisherId = publisherFilter?.value ?? '';
    let visibleGames = 0;

    for (const card of gameCards) {
      const matchesCategories = selectedCategoryIds.every(
        (categoryId) => card.dataset.gameCategoryId === categoryId,
      );
      const matchesPublisher =
        selectedPublisherId === '' || card.dataset.gamePublisherId === selectedPublisherId;
      const isVisible = matchesCategories && matchesPublisher;

      card.classList.toggle('hidden', !isVisible);
      if (isVisible) visibleGames++;
    }

    emptyState?.classList.toggle('hidden', visibleGames > 0);
  }

  for (const filter of categoryFilters) {
    filter.addEventListener('change', applyFilters);
  }

  publisherFilter?.addEventListener('change', applyFilters);
  clearFiltersButton?.addEventListener('click', () => {
    for (const filter of categoryFilters) {
      filter.checked = false;
    }
    if (publisherFilter) publisherFilter.value = '';
    applyFilters();
  });
</script>
